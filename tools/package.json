{
  "name": "karam-portfolio-tools",
  "private": true,
  "description": "Build step for the 3D gallery. Run: cd tools && npm install && npm run build",
  "scripts": {
    "build": "NODE_PATH=$PWD/node_modules esbuild ../src/gallery.js --bundle --minify --format=esm --target=es2020 --outfile=../assets/gallery.js && cp node_modules/lenis/dist/lenis.min.js ../assets/lenis.min.js"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "lenis": "1.3.26",
    "three": "0.186.1"
  }
}
